node_modules/
__pycache__/
*.pyc
.DS_Store
.native-build/
release/
validation/

# Keep only the porting index; generated test/build evidence belongs in CI artifacts.
# Add an explicit exception only for a reviewed, durable porting tracker.
/reports/*
!/reports/README.md
# Packaging regenerates the source manifest inside each release archive.
/SOURCE-SHA256SUMS.txt

# Local gateway profiles and data.
server-profiles.local.json
*.sqlite

# Deterministic IDE/runtime/sample outputs: exact fingerprints checked on every build.
/dist/studio.js
/dist/VB6-Studio-Web.html
/dist/vb6-runtime.js
/dist/examples/*.html
/src/exporter/runtime-payload.js

# Optional standalone compute package output.
/artifacts/vb6-compute/

# Source-derived OCX lab, verified by the same exact artifact manifest.
/dist/OCX-Source-Control-Lab.html

# Generated, fingerprint-verified standalone Win32 bundles.
/dist/win32-browser.js
/packages/win32-browser/dist/win32-browser.js

# Source-derived, fingerprint-verified layout/native/editor bundles.
/dist/auto-layout.js
/packages/auto-layout/dist/auto-layout.js
/dist/vb6-native.js
/src/editor/diagnostics-payload.js
/dist/studio.css

# Reusable COM/Automation tarballs and their generated manifest.
/artifacts/com-ole/

# Source-derived application styles, verified by the same exact fingerprint inventory.
/dist/vb6-controls.css

# Reproducible VB.NET migration package outputs
packages/vbnet-migration/lib/
packages/vbnet-migration/dist/
packages/vbnet-runtime/bin/
packages/vbnet-runtime/obj/
packages/vbnet-runtime-windows/bin/
packages/vbnet-runtime-windows/obj/

/artifacts/vbnet-migration/

# Authored .vb runtime sources are embedded deterministically during build.
/src/migration/runtime-sources.js

# Standalone renderer SDK: generated and checked by the exact artifact manifest.
/dist/vb6-rendering.js

# Reproducible Apple Silicon compiler bundle and native execution outputs.
/dist/vb6-macos.js
/artifacts/macos-native/

# Reproducible Intelligent UI outputs are fingerprinted, not source.
src/intelligent-ui/payload.js
packages/intelligent-ui/dist/
/dist/intelligent-ui.js
/dist/intelligent-ui-worker.js
/dist/intelligent-ui.css
/dist/intelligent-ui-mcp.html
/dist/packages/vb6-intelligent-ui-*.tgz
/dist/packages/vb6-intelligent-ui-*.tgz.sha256

# Generated isolated Intelligent UI proxy
/dist/intelligent-ui-sandbox.html

# Optional advanced editor is rebuilt from pinned dependencies and source.
/dist/advanced-editor/
/dist/VB6-Studio-Web-Advanced.html
