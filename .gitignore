node_modules/
__pycache__/
*.pyc
.DS_Store
.native-build/
release/
validation/

# Keep only the porting index; generated test/build evidence belongs in CI artifacts.
# Add an explicit exception only for a reviewed, durable porting tracker.
/reports/*
!/reports/README.md
# Packaging regenerates the source manifest inside each release archive.
/SOURCE-SHA256SUMS.txt

# Local gateway profiles and data.
server-profiles.local.json
*.sqlite

# Deterministic IDE/runtime/sample outputs: exact fingerprints checked on every build.
/dist/studio.js
/dist/VB6-Studio-Web.html
/dist/vb6-runtime.js
/dist/examples/*.html
/src/exporter/runtime-payload.js

# Optional standalone compute package output.
/artifacts/vb6-compute/

# Source-derived OCX lab, verified by the same exact artifact manifest.
/dist/OCX-Source-Control-Lab.html

# Generated, fingerprint-verified standalone Win32 bundles.
/dist/win32-browser.js
/packages/win32-browser/dist/win32-browser.js
