{
  "name": "vb6-studio-web",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Browser-native classic Visual Basic development environment and source runtime",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "node tools/serve.mjs",
    "validate": "npm run build && npm test && python tools/browser-tests.py && python tools/browser-parity-tests.py && npm run test:visual && npm run test:features && npm run test:recovery && npm run test:finalization && npm run test:boundaries && npm run test:windows && npm run test:mcp:browser && npm run test:project-browser && npm run test:mcp:agent && python tools/coding-agents-browser-tests.py",
    "test:visual": "python tools/browser-visual-tests.py",
    "test:visual:goldens": "python tools/browser-visual-tests.py --check-goldens",
    "test:features": "python tools/browser-features-04.py",
    "test:recovery": "python tools/recovery-browser-tests.py",
    "test:finalization": "python tools/browser-finalization-05.py",
    "probe:launch": "python tools/probe-launch.py",
    "package": "python tools/package-release.py",
    "test:debugger": "node --test tests/debugger-runtime.test.mjs",
    "test:debugger:browser": "python tools/browser-debugger-runtime.py",
    "test:boundaries": "python tools/browser-boundaries-06.py",
    "mcp:bridge": "node tools/mcp-bridge.mjs",
    "mcp:stdio": "node tools/mcp-stdio.mjs",
    "test:mcp": "node --test tests/mcp-*.test.mjs",
    "test:mcp:browser": "python tools/mcp-browser-tests.py",
    "test:windows": "python tools/browser-windows-tests.py",
    "build:windows": "node tools/build-windows.mjs",
    "build:classic": "node tools/build-classic.mjs",
    "test:native": "node --test tests/native-*.test.mjs",
    "fixtures:native": "node tools/native-fixtures.mjs",
    "build:win32": "node tools/build-win32.mjs",
    "test:win32": "node --test tests/win32-*.test.mjs",
    "test:win32:browser": "python tools/browser-native-build-tests.py",
    "test:project-files": "node --test tests/native-projects.test.mjs tests/native-directory.test.mjs tests/native-compatibility-review.test.mjs tests/native-zip.test.mjs tests/native-workspace.test.mjs tests/native-save-recovery.test.mjs tests/native-zip-encoding.test.mjs tests/native-snapshot.test.mjs",
    "test:project-browser": "python tools/native-project-browser-tests.py",
    "test:mcp:agent": "python tools/mcp-agent-browser-tests.py",
    "agent:relay": "node tools/agent-relay.mjs",
    "test:agents": "node --test tests/coding-agents*.test.mjs tests/agent-relay.test.mjs",
    "test:agents:browser": "python tools/coding-agents-browser-tests.py",
    "test:data": "node --test tests/data-*.test.mjs",
    "test:data:browser": "python tools/browser-data-sources.py",
    "data:examples": "node tools/data-example-server.mjs",
    "data:gateway": "node tools/data-gateway.mjs",
    "test:win32-browser": "node --test tests/win32-browser*.test.mjs",
    "test:win32-browser:browser": "python tools/browser-win32-compat-tests.py",
    "pack:win32-browser": "node tools/pack-win32-browser.mjs",
    "test:interop": "node --test tests/native-automation.test.mjs tests/native-control-adapters.test.mjs",
    "test:interop:windows": "node tools/interop/test-native.mjs",
    "verify:classic": "node tools/verify-classic-roundtrip.mjs",
    "snapshot:native": "node tools/native-snapshot.mjs",
    "test:classic-html": "python tools/browser-classic-html.py",
    "build:compute": "node tools/build-compute.mjs",
    "compile:compute": "node tools/compile-compute.mjs",
    "test:compute": "node --test tests/compute*.test.mjs",
    "test:compute:browser": "node tools/build-compute.mjs && python tools/compute-browser-tests.py"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
