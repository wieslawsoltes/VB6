{
  "schema": 1,
  "id": "example_rest-public-users_1",
  "name": "PublicRESTUsers",
  "description": "Public JSONPlaceholder users (read-only). Click Reload to make a real HTTPS request. The endpoint must allow browser CORS; results are not bundled or simulated.",
  "startup": "frmData",
  "modules": [
    {
      "id": "example_rest-public-users_2",
      "name": "frmData",
      "kind": "form",
      "code": "Option Explicit\nPrivate cn As ADODB.Connection\nPrivate rs As ADODB.Recordset\nPrivate Sub Form_Load()\n    lblStatus.Caption = \"Click Reload to connect\"\nEnd Sub\nPrivate Sub cmdLoad_Click()\n    On Error GoTo Failed\n    If cn Is Nothing Then\n        Set cn = New ADODB.Connection\n        cn.Open \"PublicUsers\"\n    End If\n    Set rs = cn.Execute(\"\")\n    Set Data1.Recordset = rs\n    grdCustomers.ColWidth(0) = 900\n    grdCustomers.ColWidth(1) = 2850\n    grdCustomers.ColWidth(2) = 3450\n    If grdCustomers.Cols > 3 Then grdCustomers.ColWidth(3) = 1500\n    lblStatus.Caption = CStr(rs.RecordCount) & \" records loaded\"\n    Exit Sub\nFailed:\n    lblStatus.Caption = \"Error \" & CStr(Err.Number)\n    MsgBox Err.Description, vbExclamation, \"Data Source\"\nEnd Sub\nPrivate Sub cmdSave_Click()\n    On Error GoTo Failed\n    MsgBox \"This example is read-only.\", vbInformation\n    lblStatus.Caption = \"Ready\"\n    Exit Sub\nFailed:\n    lblStatus.Caption = \"Error \" & CStr(Err.Number)\n    MsgBox Err.Description, vbExclamation, \"Data Source\"\nEnd Sub\nPrivate Sub cmdNew_Click()\n    On Error GoTo Failed\n    MsgBox \"This example is read-only.\", vbInformation\n    Exit Sub\nFailed:\n    lblStatus.Caption = \"Error \" & CStr(Err.Number)\n    MsgBox Err.Description, vbExclamation, \"Data Source\"\nEnd Sub\nPrivate Sub cmdDelete_Click()\n    On Error GoTo Failed\n    MsgBox \"This example is read-only.\", vbInformation\n    Exit Sub\nFailed:\n    lblStatus.Caption = \"Error \" & CStr(Err.Number)\n    MsgBox Err.Description, vbExclamation, \"Data Source\"\nEnd Sub\nPrivate Sub Form_Unload(Cancel As Integer)\n    If Not cn Is Nothing Then cn.Close\nEnd Sub\n",
