{
  "schema": 1,
  "id": "example_mdi_1",
  "name": "MDIWorkspace",
  "description": "Real MDI windows, native resource strings, cancellable unloading and dynamically created VB form instances.",
  "startup": "frmWorkspace",
  "modules": [
    {
      "id": "example_mdi_2",
      "name": "frmWorkspace",
      "kind": "form",
      "code": "Option Explicit\nPrivate documents As New Collection\nPrivate serial As Long\nPrivate Sub MDIForm_Load()\n    Me.Caption = LoadResString(101)\n    mnuNew_Click\n    mnuNew_Click\n    Me.Arrange vbTileVertical\nEnd Sub\nPrivate Sub mnuNew_Click()\n    Dim doc As New frmDocument\n    serial = serial + 1\n    doc.Caption = \"Document \" & serial\n    doc.Show\n    documents.Add doc\nEnd Sub\nPrivate Sub mnuClose_Click()\n    If Not Me.ActiveForm Is Nothing Then\n        Unload Me.ActiveForm\n    End If\nEnd Sub\nPrivate Sub mnuExit_Click()\n    Unload Me\nEnd Sub\nPrivate Sub mnuCascade_Click()\n    Me.Arrange vbCascade\nEnd Sub\nPrivate Sub mnuTileH_Click()\n    Me.Arrange vbTileHorizontal\nEnd Sub\nPrivate Sub mnuTileV_Click()\n    Me.Arrange vbTileVertical\nEnd Sub\nPrivate Sub mnuIcons_Click()\n    Me.Arrange vbArrangeIcons\nEnd Sub\n",
      "form": {
        "id": "example_mdi_3",
        "name": "frmWorkspace",
        "type": "MDIForm",
        "properties": {
          "Name": "frmWorkspace",
          "Caption": "Resource Workspace",
