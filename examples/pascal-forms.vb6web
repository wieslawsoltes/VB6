      "name": "Form1",
      "kind": "form",
      "language": "pascal",
      "code": "unit Form1;\n\ninterface\n\nimplementation\n\nprocedure Form_Load;\nbegin\n    GreetingLabel.Caption := 'A shared form designer, with Turbo Pascal source.';\nend;\n\nprocedure GreetButton_Click;\nbegin\n    GreetingLabel.Caption := 'Hello, ' + NameText.Text + '!';\nend;\n\nprocedure NameText_KeyPress(var KeyAscii: Integer);\nbegin\n    if KeyAscii = 13 then\n    begin\n        GreetButton_Click;\n        KeyAscii := 0;\n    end;\nend;\n\nend.\n",
