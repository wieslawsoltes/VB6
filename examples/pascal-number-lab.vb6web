    {
      "id": "example_pascal-number-lab_11",
      "name": "NumberSeries",
      "kind": "module",
      "language": "pascal",
      "code": "unit NumberSeries;\n\ninterface\n\nfunction Fibonacci(N: Integer): LongInt;\nfunction Triangular(N: Integer): LongInt;\n\nimplementation\n\nfunction Fibonacci(N: Integer): LongInt;\nvar\n    I: Integer;\n    A, B, Next: LongInt;\nbegin\n    A := 0;\n    B := 1;\n    for I := 1 to N do\n    begin\n        Next := A + B;\n        A := B;\n        B := Next;\n    end;\n    Fibonacci := A;\nend;\n\nfunction Triangular(N: Integer): LongInt;\nbegin\n    Triangular := LongInt(N) * (N + 1) div 2;\nend;\n\nend.\n"
    }
