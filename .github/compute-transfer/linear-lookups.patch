+/** Resolve every global once per batch. Rebuild rather than caching mutable
+ * artifact metadata; null retains ambiguity even when a third alias collides. */
+function indexGlobalFields(artifact) {
+  const fields=new Map();
+  for(const symbol of artifact.globals) {
+    const short=symbol.name.toLowerCase(),qualified=(symbol.module+'.'+short).toLowerCase();
+    for(const name of new Set([short,qualified]))fields.set(name,fields.has(name)?null:symbol);
+  }
+  return fields;
+}
+function indexedGlobalField(fields,name) {
+  const n=name.toLowerCase(),symbol=fields.get(n);
+  if(!symbol)throw new ComputeError(fields.has(n)?'Ambiguous global: '+name:'Unknown global: '+name,'GPU_NAME');
+  return symbol;
+}
