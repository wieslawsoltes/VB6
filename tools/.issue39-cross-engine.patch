+/* Match the horizontal grip's preferred width to its 6px flex basis. Gecko
+   and WebKit otherwise size the wrapping bar using its inherited 4px width,
+   leaving the final zoom control two pixels short and forcing an extra row. */
+.ide-shell .command-bar:not(.command-bar-vertical):not(.command-bar-floating) > .toolbar-grip {width:6px}
+.command-bar .toolbar-select {width:76px;min-width:76px}
