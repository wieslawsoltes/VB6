+export function installNativePreview(studio, bridge) {
+  let generation = 0;
+  studio.runtimeDocumentLoader = (frame, html) => {
+    const request = ++generation;
+    const current = () => request === generation && studio.runtimeFrame === frame && frame.isConnected;
